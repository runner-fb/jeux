// Le dossier d’inscription reste privé. Aucun identifiant de compte n’est envoyé au navigateur.
const ROOT_FOLDER_ID = PropertiesService.getScriptProperties().getProperty('ROOT_FOLDER_ID');
const HEADERS = ['Référence','Date','Statut','Tables','Total','Nom','Email','Paiement','Dossier','PDF','Mail','Données'];
function doGet(e) {
 const file=e&&e.parameter&&e.parameter.admin==='1'?'Admin':'Index';
 return HtmlService.createHtmlOutputFromFile(file).setTitle('Jeux k’Ifs · La Broc 2027').addMetaTag('viewport','width=device-width, initial-scale=1').setXFrameOptionsMode(HtmlService.XFrameOptionsMode.ALLOWALL);
}
// À exécuter une fois dans l’éditeur, connecté au compte Jeux k’Ifs.
// Le suffixe _ rend cette fonction inaccessible depuis google.script.run.
function initialiser_() {
  const props=PropertiesService.getScriptProperties();
  if (!props.getProperty('LEDGER_ID')) {
    const ss=SpreadsheetApp.create('La Broc 2027 — Inscriptions site');
    const sheet=ss.getSheets()[0];sheet.setName('Inscriptions');sheet.appendRow(HEADERS);sheet.setFrozenRows(1);
    DriveApp.getFileById(ss.getId()).moveTo(DriveApp.getFolderById(ROOT_FOLDER_ID));
    props.setProperty('LEDGER_ID',ss.getId());
  }
  const defaults={INITIAL_REMAINING:'2',PRICE:'6',MAX_TABLES:'2',OPEN:'false',CARD_URL:'',TRANSFER_INSTRUCTIONS:'',OFFLINE_INSTRUCTIONS:'Paiement par chèque ou espèces auprès de l’association Jeux k’Ifs.'};
  Object.keys(defaults).forEach(k=>{if(props.getProperty(k)===null)props.setProperty(k,defaults[k])});
}
function configuration_(){const p=PropertiesService.getScriptProperties().getProperties();const custom=readSettings_(p);return Object.assign({ledger:p.LEDGER_ID,capacity:Number(p.INITIAL_REMAINING),price:Number(p.PRICE)||6,maxTables:Number(p.MAX_TABLES)||2,open:p.OPEN==='true',cardUrls:{'1':'https://pay.sumup.com/b2c/Q7AM35DM','2':'https://pay.sumup.com/b2c/QSW2RNCC'},transferInstructions:p.TRANSFER_INSTRUCTIONS||'',offlineInstructions:p.OFFLINE_INSTRUCTIONS||'Paiement par chèque ou espèces auprès de l’association Jeux k’Ifs.',title:'Jeux k’Ifs la Broc',date:'7 février 2027',location:'Salle de convivialité, Gymnase A. Milliat, 14123 Ifs',logo:'https://www.jotform.com/uploads/bodereaua838/form_files/20250524_134509_0000.6936ba6f6db531.24136317.jpg',green:'#467a32',lime:'#9dbb30',intro:'Jeux k’Ifs La Broc est ouverte aux particuliers, associations et ludothèques uniquement.',rules:defaultRules_(),emailSubject:'Merci de votre inscription à Jeux k’Ifs La Broc !',emailBody:"Merci !! Votre inscription pour {{titre}} est prise en compte.\n\nBonjour,\n\nNous vous confirmons votre inscription à {{titre}} !!\n\nDétails de l’événement\nDate : {{date}}\nLieu : {{lieu}}\nParticipants : Ouvert exclusivement aux particuliers, associations et ludothèques.\n\nRappel important\n• Les réservations sont confirmées uniquement après paiement complet.\n• Le règlement interdit la participation des professionnels, auto-entrepreneurs et revendeurs réguliers.\n• Les documents requis (pièce d’identité et attestation sur l’honneur) doivent être fournis.\n• Le respect des consignes de sécurité et du bon déroulement de la manifestation est obligatoire.\n• Les emplacements sont attribués par l’organisation et ne peuvent être modifiés le jour même.\n\nNous sommes impatients de vous accueillir le {{date}} à Ifs pour partager ensemble notre passion du jeu.\n\nLudiquement,\nL’équipe Jeux k’Ifs\n\nRéférence : {{reference}}\nTables : {{tables}}\nMode de paiement : \n{{paiement}}\n\n\nVotre document d’acceptation personnalisé est joint à ce mail.",copy:{},fieldLabels:{}},custom);}
function defaultRules_(){return JSON.parse(HtmlService.createHtmlOutputFromFile('Index').getContent().match(/const RULES=(.*);/)[1]);}
function paymentUrl_(d,c){return c.cardUrls[String(d.tables)]||'';}
function ledger_(c){if(!c.ledger)throw Error('Le formulaire est en cours de configuration.');return SpreadsheetApp.openById(c.ledger).getSheetByName('Inscriptions');}
function remaining_(sheet,c){const rows=sheet.getDataRange().getValues();return Math.max(0,c.capacity-rows.slice(1).filter(r=>r[2]!=='ANNULEE').reduce((n,r)=>n+Number(r[3]||0),0));}
function getPublicConfig(){const c=configuration_();const out={};['price','maxTables','transferInstructions','offlineInstructions','title','date','location','logo','green','lime','intro','rules','copy','fieldLabels'].forEach(k=>out[k]=c[k]);return Object.assign(out,{open:c.open&&!!c.ledger,remaining:c.ledger?remaining_(ledger_(c),c):0,cardQuantities:Object.keys(c.cardUrls).filter(k=>c.cardUrls[k]),adminUrl:ScriptApp.getService().getUrl()+'?admin=1'});}
function clean_(v,max){if(typeof v!=='string'||v.length>(max||180))throw Error('Un champ est trop long ou invalide.');return v.trim();}
function person_(f,prefix){const out={};['First','Last','Street','City','Zip','Phone','Email'].forEach(k=>{out[k]=clean_(f[prefix+k]);if(!out[k])throw Error('Coordonnées du participant incomplètes.');});['Extra','Region'].forEach(k=>out[k]=clean_(f[prefix+k]||''));if(!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(out.Email)||/[\r\n,;]/.test(out.Email))throw Error('Adresse email invalide.');if(!/^[+\d ().-]{8,25}$/.test(out.Phone))throw Error('Numéro de téléphone invalide.');return out;}
function validate_(payload,c){
 if(!payload||!/^[-a-f0-9]{36}$/.test(payload.id||''))throw Error('Référence invalide.');
 const f=payload.fields||{};if(f.website||f.accepted!==true||f.nonProfessional!==true)throw Error('Veuillez accepter les conditions du formulaire.');
 if(!['Particulier','Association ou ludothèque'].includes(f.kind))throw Error('Statut invalide.');
 const tables=Number(f.tables);if(!Number.isInteger(tables)||tables<1||tables>c.maxTables)throw Error('Nombre de tables invalide.');
 if(!['card','offline','transfer'].includes(f.payment))throw Error('Mode de paiement invalide.');
 const people=[person_(f,'p1')];if(f.second===true)people.push(person_(f,'p2'));
 let organisation=null;if(f.kind!=='Particulier'){organisation={};['orgName','orgStreet','orgCity','orgZip','orgRole'].forEach(k=>{organisation[k]=clean_(f[k]);if(!organisation[k])throw Error('Informations de l’association incomplètes.');});['orgExtra','orgRegion'].forEach(k=>organisation[k]=clean_(f[k]||''));}
 const keys=['identity1','attestation1',...(people.length===2?['identity2','attestation2']:[])];
 if(!Array.isArray(payload.files)||payload.files.length!==keys.length)throw Error('Pièces jointes incomplètes.');
 let total=0;const files=keys.map(key=>{const a=payload.files.filter(x=>x.key===key);if(a.length!==1)throw Error('Pièce jointe manquante.');const file=a[0];if(typeof file.data!=='string'||file.data.length>5600000||! /^[A-Za-z0-9+/]*={0,2}$/.test(file.data))throw Error('Fichier invalide.');
 const types={'application/pdf':{sig:'JVBER',ext:'.pdf'},'image/jpeg':{sig:'/9j/',ext:'.jpg'},'image/png':{sig:'iVBORw0KGgo',ext:'.png'}};const type=types[file.mime];if(!type||!file.data.startsWith(type.sig))throw Error('Seuls les fichiers PDF, JPG et PNG sont acceptés.');const bytes=Utilities.base64Decode(file.data);total+=bytes.length;if(!bytes.length||bytes.length>4*1024*1024)throw Error('Fichier vide ou supérieur à 4 Mo.');return {key,blob:Utilities.newBlob(bytes,file.mime,key+type.ext)};});if(total>12*1024*1024)throw Error('Les pièces jointes dépassent 12 Mo.');
 return {id:payload.id,kind:f.kind,tables,payment:f.payment,people,organisation,files};
}
function safeCell_(v){const s=String(v);return /^[=+@\-]/.test(s)?"'"+s:s;}
function fingerprint_(data){return Utilities.base64Encode(Utilities.computeDigest(Utilities.DigestAlgorithm.SHA_256,JSON.stringify({kind:data.kind,tables:data.tables,payment:data.payment,people:data.people,organisation:data.organisation})));}
function submitRegistration(payload){return submit_(payload,false);}
function submit_(payload,isTest){
 let c=configuration_();
 if(isTest){c.ledger=PropertiesService.getScriptProperties().getProperty('TEST_LEDGER_ID');c.capacity=100;c.open=true;}
 const data=validate_(payload,c);data.test=isTest;const lock=LockService.getScriptLock();if(!lock.tryLock(30000))throw Error('Une inscription est en cours. Réessayez dans quelques instants.');
 try {
 if(!isTest)c=configuration_();
 if(data.tables>c.maxTables)throw Error('Le maximum de tables a changé. Rechargez le formulaire.');
 if(data.payment==='card'&&!paymentUrl_(data,c))throw Error('Paiement par carte indisponible pour ce nombre de tables.');
 if(data.payment==='transfer'&&!c.transferInstructions)throw Error('Le virement n’est pas disponible.');
 const sheet=ledger_(c);const rows=sheet.getDataRange().getValues();let index=rows.findIndex(r=>r[0]===data.id),row=index+1,record=index>=1?rows[index]:null;const digest=fingerprint_(data);
 if(record){let stored=JSON.parse(record[11]);if(stored.fingerprint!==digest)throw Error('Cette référence est déjà utilisée. Rechargez le formulaire.');if(record[2]==='ANNULEE')throw Error('Cette inscription a été annulée.');if(record[2]==='ENREGISTREE')return response_(data,c,record[10]==='ENVOYE');}
 if(!record){if(!c.open)throw Error('Les inscriptions sont fermées.');if(data.tables>remaining_(sheet,c))throw Error('Le nombre de tables disponibles a changé. Rechargez le formulaire.');
 row=sheet.getLastRow()+1;const stored={rules:c.rules,price:c.price,fingerprint:digest,people:data.people,organisation:data.organisation,kind:data.kind,accepted:true,rulesVersion:'2027-01-dates-corrigees'};
 sheet.appendRow([data.id,new Date(),'EN_COURS',data.tables,data.tables*c.price,safeCell_(data.people[0].First+' '+data.people[0].Last),safeCell_(data.people[0].Email),data.payment,'','','A_ENVOYER',JSON.stringify(stored)]);SpreadsheetApp.flush();record=sheet.getRange(row,1,1,12).getValues()[0];}
 const snapshot=JSON.parse(record[11]);data.rules=snapshot.rules||c.rules;data.total=Number(record[4]);
 let folder;if(record[8])folder=DriveApp.getFolderById(record[8]);else{folder=DriveApp.getFolderById(ROOT_FOLDER_ID).createFolder(data.people[0].First+' '+data.people[0].Last+' — '+data.id.slice(0,8));sheet.getRange(row,9).setValue(folder.getId());SpreadsheetApp.flush();}
 for(const file of data.files){if(!folder.getFilesByName(file.blob.getName()).hasNext())folder.createFile(file.blob);}
 let pdf;if(record[9])pdf=DriveApp.getFileById(record[9]);else{const existing=folder.getFilesByName('Acceptation-reglement.pdf');pdf=existing.hasNext()?existing.next():pdf_(data,folder,record[1],Number(record[4]));sheet.getRange(row,10).setValue(pdf.getId());}
 sheet.getRange(row,3).setValue('ENREGISTREE');SpreadsheetApp.flush();
 // Un échec d’envoi ne transforme jamais une inscription enregistrée en échec de réservation.
 let sent=false;try{if(MailApp.getRemainingDailyQuota()>0){sheet.getRange(row,11).setValue('ENVOI_EN_COURS');SpreadsheetApp.flush();MailApp.sendEmail({to:data.people[0].Email,subject:(data.test?"[TEST] ":"")+c.emailSubject,name:'Jeux k’Ifs',body:emailText_(data,c),htmlBody:emailHtml_(data,c),attachments:[pdf.getBlob()]});sent=true;sheet.getRange(row,11).setValue('ENVOYE');}}catch(error){sheet.getRange(row,11).setValue('A_VERIFIER');}
 return response_(data,c,sent);
 }catch(error){throw Error(error.message||'Enregistrement interrompu. Réessayez avec les mêmes informations.');}finally{lock.releaseLock();}
}
function response_(d,c,sent){return {reference:d.id,emailSent:sent,cardUrl:d.payment==='card'?paymentUrl_(d,c):'',instructions:d.payment==='transfer'?c.transferInstructions:d.payment==='offline'?c.offlineInstructions:'Votre inscription est enregistrée. Procédez maintenant au paiement.'};}
function pdf_(d,folder,date,total){const doc=DocumentApp.create('Acceptation '+d.id);const body=doc.getBody();const c=configuration_();body.appendParagraph((d.test?'TEST — ':'')+c.title).setHeading(DocumentApp.ParagraphHeading.HEADING1);body.appendParagraph('Document d’acceptation du règlement intérieur — '+c.title+' — '+c.date+' — '+c.location);
 if(d.organisation){body.appendParagraph('Association ou ludothèque').setHeading(DocumentApp.ParagraphHeading.HEADING2);Object.values(d.organisation).filter(Boolean).forEach(x=>body.appendParagraph(x));}
 d.people.forEach((p,i)=>{body.appendParagraph('Identification de l’exposant'+(i?' 2':'')).setHeading(DocumentApp.ParagraphHeading.HEADING2);body.appendTable([['Nom et prénom',p.First+' '+p.Last],['Adresse',[p.Street,p.Extra,p.Zip+' '+p.City,p.Region].filter(Boolean).join('\n')],['E-mail',p.Email],['Téléphone',p.Phone],['Statut du participant',d.kind]]);});
 body.appendParagraph('Informations de réservation').setHeading(DocumentApp.ParagraphHeading.HEADING2);body.appendTable([['Nombre de tables réservées',String(d.tables)],['Montant',total.toFixed(2)+' €'],['Mode de paiement',paymentLabel_(d.payment)],['Référence',d.id],['Date et heure',Utilities.formatDate(new Date(date),'Europe/Paris','dd/MM/yyyy HH:mm:ss')]]);
 body.appendParagraph(d.rules||c.rules);body.appendParagraph('Déclaration finale').setHeading(DocumentApp.ParagraphHeading.HEADING2);body.appendParagraph('Je soussigné(e), '+d.people[0].First+' '+d.people[0].Last+', reconnais avoir pris connaissance de l’intégralité du règlement intérieur de '+c.title+' et en accepter toutes les dispositions.');body.appendParagraph('Réponse d’acceptation : J’ai lu et j’accepte le règlement de La Broc.');body.appendParagraph('Référence : '+d.id+' — '+Utilities.formatDate(new Date(date),'Europe/Paris','dd/MM/yyyy HH:mm:ss'));doc.saveAndClose();const source=DriveApp.getFileById(doc.getId());source.moveTo(folder);const pdf=folder.createFile(source.getAs(MimeType.PDF).setName('Acceptation-reglement.pdf'));source.setTrashed(true);return pdf;
}
function paymentLabel_(p){return {card:'Par carte bancaire en ligne',offline:'Par chèque ou espèces à l’association',transfer:'Par virement bancaire'}[p];}
function emailText_(d,c){const values={prenom:d.people[0].First,nom:d.people[0].Last,titre:c.title,date:c.date,lieu:c.location,tables:d.tables,total:(d.total===undefined?d.tables*c.price:d.total).toFixed(2),reference:d.id,paiement:response_(d,c,false).instructions+(d.payment==='card'?'\n'+paymentUrl_(d,c):'')};return (d.test?'TEST TECHNIQUE — aucune table réelle réservée.\n\n':'')+c.emailBody.replace(/\{\{(\w+)\}\}/g,(m,k)=>Object.prototype.hasOwnProperty.call(values,k)?values[k]:m);}
function escape_(s){return String(s).replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));}
function emailHtml_(d,c){return '<div style="font-family:Arial,sans-serif;max-width:640px;margin:auto;border-top:6px solid #8dab36;padding:24px;color:#26342c"><h1 style="color:#467a32;font-size:24px">'+escape_(c.title)+'</h1>'+escape_(emailText_(d,c)).replace(/\n/g,'<br>')+'</div>';}

// Codes envoyés uniquement au propriétaire du script. Aucun secret dans les pages publiques.
function hash_(value){return Utilities.base64EncodeWebSafe(Utilities.computeDigest(Utilities.DigestAlgorithm.SHA_256,value));}
function requestAdminCode(){const lock=LockService.getScriptLock();lock.waitLock(10000);try{const p=PropertiesService.getScriptProperties(),now=Date.now();let a=JSON.parse(p.getProperty('ADMIN_OTP')||'{}');if(now-(a.sent||0)<60000)throw Error('Attendez une minute avant de demander un nouveau code.');const hour=Math.floor(now/3600000);let rate=JSON.parse(p.getProperty('ADMIN_RATE')||'{}');if(rate.hour===hour&&rate.count>=5)throw Error('Trop de demandes. Réessayez dans une heure.');const code=Utilities.getUuid().replace(/-/g,'').slice(0,10).toUpperCase();const challenge=Utilities.getUuid();p.setProperty('ADMIN_RATE',JSON.stringify({hour,count:rate.hour===hour?rate.count+1:1}));p.setProperty('ADMIN_OTP',JSON.stringify({hash:hash_(code),challenge,sent:now,expires:now+600000,attempts:0}));MailApp.sendEmail(Session.getEffectiveUser().getEmail(),'Code d’administration — Jeux k’Ifs', 'Votre code : '+code+'\nValable 10 minutes. Ne le transmettez pas.\nSi vous n’avez pas demandé ce code, ignorez ce message.');return {challenge};}finally{lock.releaseLock();}}
function adminLogin(challenge,code){const lock=LockService.getScriptLock();lock.waitLock(10000);try{const p=PropertiesService.getScriptProperties(),a=JSON.parse(p.getProperty('ADMIN_OTP')||'{}');if(!a.hash||a.expires<Date.now()||a.attempts>=5||a.challenge!==challenge)throw Error('Code expiré. Demandez un nouveau code.');a.attempts++;p.setProperty('ADMIN_OTP',JSON.stringify(a));if(hash_(String(code).trim().toUpperCase())!==a.hash)throw Error('Code incorrect.');p.deleteProperty('ADMIN_OTP');const token=Utilities.getUuid()+Utilities.getUuid();CacheService.getScriptCache().put('admin:'+hash_(token),'ok',3600);return {token};}finally{lock.releaseLock();}}
function requireAdmin_(token){if(typeof token!=='string'||token.length>100||CacheService.getScriptCache().get('admin:'+hash_(token))!=='ok')throw Error('Session expirée. Reconnectez-vous.');}
function adminLogout(token){requireAdmin_(token);CacheService.getScriptCache().remove('admin:'+hash_(token));return true;}
function adminGetSettings(token){requireAdmin_(token);const c=configuration_(),sheet=ledger_(c),rows=sheet.getDataRange().getValues().slice(1);const used=rows.filter(r=>r[2]!=='ANNULEE').reduce((n,r)=>n+Number(r[3]||0),0);const settings={};['open','price','maxTables','cardUrls','transferInstructions','offlineInstructions','title','date','location','logo','green','lime','intro','rules','emailSubject','emailBody','copy','fieldLabels'].forEach(k=>settings[k]=c[k]);return {settings,remaining:Math.max(0,c.capacity-used),used,version:PropertiesService.getScriptProperties().getProperty('SETTINGS_VERSION')||'0',registrations:rows.map(r=>({reference:r[0],date:r[1] instanceof Date?r[1].toISOString():String(r[1]),status:r[2],tables:r[3],total:r[4],name:r[5],email:r[6],mail:r[10],folder:r[8]?'https://drive.google.com/drive/folders/'+r[8]:'',pdf:r[9]?'https://drive.google.com/file/d/'+r[9]+'/view':''}))};}
function adminSaveSettings(token,payload){requireAdmin_(token);if(!payload||!payload.settings)throw Error('Paramètres manquants.');const v=payload.settings,c={};const strings={title:180,date:180,location:500,intro:2000,rules:8000,emailSubject:180,emailBody:8000,transferInstructions:2000,offlineInstructions:2000,logo:2000};Object.keys(strings).forEach(k=>c[k]=clean_(v[k],strings[k]));['title','date','location','rules','emailSubject','emailBody'].forEach(k=>{if(!c[k])throw Error('Champ obligatoire : '+k);});if(/[\r\n]/.test(c.emailSubject))throw Error('Objet du mail invalide.');if(!/^https:\/\/[^\s]+$/.test(c.logo))throw Error('Le logo doit utiliser une adresse HTTPS.');['green','lime'].forEach(k=>{if(!/^#[0-9a-f]{6}$/i.test(v[k]))throw Error('Couleur invalide.');c[k]=v[k];});c.price=Number(v.price);c.maxTables=Number(v.maxTables);c.open=v.open===true;if(!Number.isFinite(c.price)||c.price<=0||c.price>10000||!Number.isInteger(c.maxTables)||c.maxTables<1||c.maxTables>50)throw Error('Tarif ou maximum de tables invalide.');c.cardUrls={};Object.keys(v.cardUrls||{}).forEach(k=>{const n=Number(k),url=clean_(v.cardUrls[k],1000);if(!Number.isInteger(n)||n<1||n>50||url&&!/^https:\/\/pay\.sumup\.com\/b2c\/[A-Za-z0-9]+$/.test(url))throw Error('Lien SumUp invalide.');if(url)c.cardUrls[n]=url;});['copy','fieldLabels'].forEach(k=>{c[k]={};Object.keys(v[k]||{}).forEach(id=>{if(!/^[a-zA-Z0-9_-]{1,80}$/.test(id))throw Error('Identifiant de texte invalide.');c[k][id]=clean_(v[k][id],2000);});});if(JSON.stringify(c).length>30000)throw Error('Configuration trop volumineuse.');const lock=LockService.getScriptLock();lock.waitLock(30000);try{const p=PropertiesService.getScriptProperties();if((p.getProperty('SETTINGS_VERSION')||'0')!==payload.version)throw Error('Les réglages ont changé. Rechargez avant d’enregistrer.');const current=configuration_(),rows=ledger_(current).getDataRange().getValues().slice(1);const used=rows.filter(r=>r[2]!=='ANNULEE').reduce((n,r)=>n+Number(r[3]||0),0);if(payload.remaining!==null){const n=Number(payload.remaining);if(!Number.isInteger(n)||n<0||n>10000)throw Error('Stock invalide.');if(used!==payload.used)throw Error('Une inscription vient d’arriver. Rechargez avant de modifier le stock.');p.setProperty('INITIAL_REMAINING',String(used+n));}writeSettings_(p,c);p.setProperty('SETTINGS_VERSION',Utilities.getUuid());return adminGetSettings(token);}finally{lock.releaseLock();}}

function readSettings_(p){if(!p.FORM_PARTS)return JSON.parse(p.FORM_SETTINGS||'{}');let json='';for(let i=0;i<Number(p.FORM_PARTS);i++)json+=p['FORM_PART_'+i]||'';return JSON.parse(json);}
function writeSettings_(p,value){const json=JSON.stringify(value);let i=0;for(let n=0;n<json.length;n+=2000)p.setProperty('FORM_PART_'+(i++),json.slice(n,n+2000));p.setProperty('FORM_PARTS',String(i));}
