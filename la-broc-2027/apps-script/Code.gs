const ROOT_FOLDER_ID=PropertiesService.getScriptProperties().getProperty('ROOT_FOLDER_ID');
const HEADERS=['Référence','Date','Statut','Tables','Total','Nom','Email','Paiement','Dossier','PDF','Mail','Données'];
function doGet(){return HtmlService.createHtmlOutputFromFile('Index').setTitle('Jeux k’Ifs · La Broc 2027').addMetaTag('viewport','width=device-width, initial-scale=1').setXFrameOptionsMode(HtmlService.XFrameOptionsMode.ALLOWALL);}
function initialiser_(){const p=PropertiesService.getScriptProperties();if(!p.getProperty('LEDGER_ID')){const ss=SpreadsheetApp.create('La Broc 2027 — Inscriptions site');const sh=ss.getSheets()[0];sh.setName('Inscriptions');sh.appendRow(HEADERS);sh.setFrozenRows(1);DriveApp.getFileById(ss.getId()).moveTo(DriveApp.getFolderById(ROOT_FOLDER_ID));p.setProperty('LEDGER_ID',ss.getId());}const d={INITIAL_REMAINING:'8',PRICE:'6',MAX_TABLES:'8',OPEN:'false',CARD_URL:'',TRANSFER_INSTRUCTIONS:'',OFFLINE_INSTRUCTIONS:'Paiement par chèque ou espèces auprès de l’association Jeux k’Ifs.'};Object.keys(d).forEach(k=>{if(p.getProperty(k)===null)p.setProperty(k,d[k]);});}
function configuration_(){const p=PropertiesService.getScriptProperties().getProperties();return {ledger:p.LEDGER_ID,capacity:Number(p.INITIAL_REMAINING),price:Number(p.PRICE),maxTables:Number(p.MAX_TABLES),open:p.OPEN==='true',cardUrl:p.CARD_URL||'',transferInstructions:p.TRANSFER_INSTRUCTIONS||'',offlineInstructions:p.OFFLINE_INSTRUCTIONS||''};}
function ledger_(c){if(!c.ledger)throw Error('Le formulaire est en cours de configuration.');return SpreadsheetApp.openById(c.ledger).getSheetByName('Inscriptions');}
function remaining_(s,c){return Math.max(0,c.capacity-s.getDataRange().getValues().slice(1).filter(r=>r[2]!=='ANNULEE').reduce((n,r)=>n+Number(r[3]||0),0));}
function getPublicConfig(){const c=configuration_();return {open:c.open&&!!c.ledger,remaining:c.ledger?remaining_(ledger_(c),c):0,price:c.price||6,maxTables:c.maxTables||8,transferInstructions:c.transferInstructions,offlineInstructions:c.offlineInstructions};}
function clean_(v,max){if(typeof v!=='string'||v.length>(max||180))throw Error('Un champ est trop long ou invalide.');return v.trim();}
function person_(f,prefix){const out={};['First','Last','Street','City','Zip','Phone','Email'].forEach(k=>{out[k]=clean_(f[prefix+k]);if(!out[k])throw Error('Coordonnées du participant incomplètes.');});['Extra','Region'].forEach(k=>out[k]=clean_(f[prefix+k]||''));if(!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(out.Email)||/[\r\n,;]/.test(out.Email))throw Error('Adresse email invalide.');if(!/^[+\d ().-]{8,25}$/.test(out.Phone))throw Error('Numéro de téléphone invalide.');return out;}
function validate_(payload,c){if(!payload||!/^[-a-f0-9]{36}$/.test(payload.id||''))throw Error('Référence invalide.');const f=payload.fields||{};if(f.website||f.accepted!==true||f.nonProfessional!==true)throw Error('Veuillez accepter les conditions du formulaire.');if(!['Particulier','Association ou ludothèque'].includes(f.kind))throw Error('Statut invalide.');const tables=Number(f.tables);if(!Number.isInteger(tables)||tables<1||tables>c.maxTables)throw Error('Nombre de tables invalide.');if(!['card','offline','transfer'].includes(f.payment))throw Error('Mode de paiement invalide.');const people=[person_(f,'p1')];if(f.second===true)people.push(person_(f,'p2'));let organisation=null;if(f.kind!=='Particulier'){organisation={};['orgName','orgStreet','orgCity','orgZip','orgRole'].forEach(k=>{organisation[k]=clean_(f[k]);if(!organisation[k])throw Error('Informations de l’association incomplètes.');});['orgExtra','orgRegion'].forEach(k=>organisation[k]=clean_(f[k]||''));}const keys=['identity1','attestation1',...(people.length===2?['identity2','attestation2']:[])];if(!Array.isArray(payload.files)||payload.files.length!==keys.length)throw Error('Pièces jointes incomplètes.');let total=0;const files=keys.map(key=>{const a=payload.files.filter(x=>x.key===key);if(a.length!==1)throw Error('Pièce jointe manquante.');const file=a[0];if(typeof file.data!=='string'||file.data.length>5600000||!/^[A-Za-z0-9+/]*={0,2}$/.test(file.data))throw Error('Fichier invalide.');const types={'application/pdf':{sig:'JVBER',ext:'.pdf'},'image/jpeg':{sig:'/9j/',ext:'.jpg'},'image/png':{sig:'iVBORw0KGgo',ext:'.png'}};const type=types[file.mime];if(!type||!file.data.startsWith(type.sig))throw Error('Seuls les fichiers PDF, JPG et PNG sont acceptés.');const bytes=Utilities.base64Decode(file.data);total+=bytes.length;if(!bytes.length||bytes.length>4*1024*1024)throw Error('Fichier vide ou supérieur à 4 Mo.');return {key,blob:Utilities.newBlob(bytes,file.mime,key+type.ext)};});if(total>12*1024*1024)throw Error('Les pièces jointes dépassent 12 Mo.');return {id:payload.id,kind:f.kind,tables,payment:f.payment,people,organisation,files};}
function safeCell_(v){const s=String(v);return /^[=+@-]/.test(s)?"'"+s:s;}
function fingerprint_(d){return Utilities.base64Encode(Utilities.computeDigest(Utilities.DigestAlgorithm.SHA_256,JSON.stringify({kind:d.kind,tables:d.tables,payment:d.payment,people:d.people,organisation:d.organisation})));}
function submitRegistration(payload){return submit_(payload,false);}
function submit_(payload,isTest){const c=configuration_();if(isTest){c.ledger=PropertiesService.getScriptProperties().getProperty('TEST_LEDGER_ID');c.capacity=100;c.open=true;}const d=validate_(payload,c);d.test=isTest;const lock=LockService.getScriptLock();if(!lock.tryLock(30000))throw Error('Une inscription est en cours. Réessayez dans quelques instants.');try{const sh=ledger_(c),rows=sh.getDataRange().getValues();let i=rows.findIndex(r=>r[0]===d.id),row=i+1,r=i>=1?rows[i]:null;const digest=fingerprint_(d);if(r){if(JSON.parse(r[11]).fingerprint!==digest)throw Error('Cette référence est déjà utilisée. Rechargez le formulaire.');if(r[2]==='ANNULEE')throw Error('Cette inscription a été annulée.');if(r[2]==='ENREGISTREE')return response_(d,c,r[10]==='ENVOYE');}if(!r){if(!c.open)throw Error('Les inscriptions sont fermées.');if(d.tables>remaining_(sh,c))throw Error('Le nombre de tables disponibles a changé. Rechargez le formulaire.');row=sh.getLastRow()+1;sh.appendRow([d.id,new Date(),'EN_COURS',d.tables,d.tables*c.price,safeCell_(d.people[0].First+' '+d.people[0].Last),safeCell_(d.people[0].Email),d.payment,'','','A_ENVOYER',JSON.stringify({fingerprint:digest,people:d.people,organisation:d.organisation,kind:d.kind,accepted:true,rulesVersion:'2027-01-dates-corrigees'})]);SpreadsheetApp.flush();r=sh.getRange(row,1,1,12).getValues()[0];}let folder;if(r[8])folder=DriveApp.getFolderById(r[8]);else{folder=DriveApp.getFolderById(ROOT_FOLDER_ID).createFolder(d.people[0].First+' '+d.people[0].Last+' — '+d.id.slice(0,8));sh.getRange(row,9).setValue(folder.getId());SpreadsheetApp.flush();}for(const f of d.files){if(!folder.getFilesByName(f.blob.getName()).hasNext())folder.createFile(f.blob);}let pdf;if(r[9])pdf=DriveApp.getFileById(r[9]);else{const existing=folder.getFilesByName('Acceptation-reglement.pdf');pdf=existing.hasNext()?existing.next():pdf_(d,folder,r[1],Number(r[4]));sh.getRange(row,10).setValue(pdf.getId());}sh.getRange(row,3).setValue('ENREGISTREE');SpreadsheetApp.flush();let sent=false;try{if(MailApp.getRemainingDailyQuota()>0){sh.getRange(row,11).setValue('ENVOI_EN_COURS');SpreadsheetApp.flush();MailApp.sendEmail({to:d.people[0].Email,subject:(d.test?'[TEST] ':'')+'Merci de votre inscription à Jeux k’Ifs La Broc !',name:'Jeux k’Ifs',body:emailText_(d,c),htmlBody:emailHtml_(d,c),attachments:[pdf.getBlob()]});sent=true;sh.getRange(row,11).setValue('ENVOYE');}}catch(error){sh.getRange(row,11).setValue('A_VERIFIER');}return response_(d,c,sent);}catch(error){throw Error(error.message||'Enregistrement interrompu. Réessayez avec les mêmes informations.');}finally{lock.releaseLock();}}
function response_(d,c,sent){return {reference:d.id,emailSent:sent,cardUrl:d.payment==='card'&&c.cardUrl.startsWith('https://')?c.cardUrl:'',instructions:d.payment==='transfer'?c.transferInstructions:d.payment==='offline'?c.offlineInstructions:(c.cardUrl?'Votre inscription est enregistrée. Procédez maintenant au paiement.':'Votre inscription est enregistrée. Contactez Jeux k’Ifs pour le paiement par carte.')};}
function rules_(){return JSON.parse(HtmlService.createHtmlOutputFromFile('Index').getContent().match(/const RULES=(.*);/)[1]);}
function pdf_(d,folder,date,total){const doc=DocumentApp.create('Acceptation '+d.id),b=doc.getBody();b.appendParagraph((d.test?'TEST — ':'')+'Jeux K’Ifs — La Broc 2027').setHeading(DocumentApp.ParagraphHeading.HEADING1);b.appendParagraph('Document d’acceptation du règlement intérieur relatif à la participation à La Broc, organisée le 7 février 2027 à la Salle de convivialité du Gymnase A. Milliat, 14123 Ifs.');if(d.organisation){b.appendParagraph('Association ou ludothèque').setHeading(DocumentApp.ParagraphHeading.HEADING2);Object.values(d.organisation).filter(Boolean).forEach(x=>b.appendParagraph(x));}d.people.forEach((p,i)=>{b.appendParagraph('Identification de l’exposant'+(i?' 2':'')).setHeading(DocumentApp.ParagraphHeading.HEADING2);b.appendTable([['Nom et prénom',p.First+' '+p.Last],['Adresse',[p.Street,p.Extra,p.Zip+' '+p.City,p.Region].filter(Boolean).join('\n')],['E-mail',p.Email],['Téléphone',p.Phone],['Statut du participant',d.kind]]);});b.appendParagraph('Informations de réservation').setHeading(DocumentApp.ParagraphHeading.HEADING2);b.appendTable([['Nombre de tables réservées',String(d.tables)],['Montant',total.toFixed(2)+' €'],['Mode de paiement',paymentLabel_(d.payment)],['Référence',d.id],['Date et heure',Utilities.formatDate(new Date(date),'Europe/Paris','dd/MM/yyyy HH:mm:ss')]]);b.appendParagraph(rules_());b.appendParagraph('Déclaration finale').setHeading(DocumentApp.ParagraphHeading.HEADING2);b.appendParagraph('Je soussigné(e), '+d.people[0].First+' '+d.people[0].Last+', reconnais avoir pris connaissance de l’intégralité du règlement intérieur de Jeux K’Ifs – La Broc et en accepter toutes les dispositions.');b.appendParagraph('Réponse d’acceptation : J’ai lu et j’accepte le règlement de La Broc.');b.appendParagraph('Référence : '+d.id+' — '+Utilities.formatDate(new Date(date),'Europe/Paris','dd/MM/yyyy HH:mm:ss'));doc.saveAndClose();const source=DriveApp.getFileById(doc.getId());source.moveTo(folder);const pdf=folder.createFile(source.getAs(MimeType.PDF).setName('Acceptation-reglement.pdf'));source.setTrashed(true);return pdf;}
function paymentLabel_(p){return {card:'Par carte bancaire en ligne',offline:'Par chèque ou espèces à l’association',transfer:'Par virement bancaire'}[p];}
function emailText_(d,c){return (d.test?'TEST TECHNIQUE — aucune table réelle réservée.\n\n':'')+'Merci !! Votre inscription pour Jeux k’Ifs la Broc est prise en compte.\n\nBonjour,\n\nNous vous confirmons votre inscription à Jeux k’Ifs la Broc !!\n\nDétails de l’événement\nDate : 7 février 2027\nLieu : Salle de convivialité, Gymnase A. Milliat, 14123 Ifs\nParticipants : Ouvert exclusivement aux particuliers, associations et ludothèques.\n\nRappel important\n• Les réservations sont confirmées uniquement après paiement complet.\n• Le règlement interdit la participation des professionnels, auto-entrepreneurs et revendeurs réguliers.\n• Les documents requis (pièce d’identité et attestation sur l’honneur) doivent être fournis.\n• Le respect des consignes de sécurité et du bon déroulement de la manifestation est obligatoire.\n• Les emplacements sont attribués par l’organisation et ne peuvent être modifiés le jour même.\n\nNous sommes impatients de vous accueillir le 7 février 2027 à Ifs pour partager ensemble notre passion du jeu.\n\nLudiquement,\nL’équipe Jeux k’Ifs\n\nRéférence : '+d.id+'\nTables : '+d.tables+'\nMode de paiement : '+paymentLabel_(d.payment)+'\n'+response_(d,c,false).instructions+'\n'+(d.payment==='card'?c.cardUrl:'')+'\n\nVotre document d’acceptation personnalisé est joint à ce mail.';}
function escape_(s){return String(s).replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));}
function emailHtml_(d,c){return '<div style="font-family:Arial,sans-serif;max-width:640px;margin:auto;border-top:6px solid #8dab36;padding:24px;color:#26342c"><h1 style="color:#467a32;font-size:24px">Jeux k’Ifs · La Broc 2027</h1>'+escape_(emailText_(d,c)).replace(/\n/g,'<br>')+'</div>';}
